# Firebase Client (public — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only; never expose)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie name (optional override)
SESSION_COOKIE_NAME=session

# Email (required when email features are enabled)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Security (required when cancel-token feature is enabled; min 32 chars)
CANCEL_TOKEN_SECRET=

# AI (required for Claude-powered email generation)
ANTHROPIC_API_KEY=
